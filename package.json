{
  "name": "@terricsh/dsh-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for the DeepSeek Harness Web GUI: own window + tray, manages the local dsh web server (attach or spawn).",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "make-icon": "electron scripts/make-icon.mjs",
    "bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-harness.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.terricsh.dsh-desktop",
    "productName": "DSH Desktop",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/harness",
        "to": "harness",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerricSH/dsh-desktop.git"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "electron",
    "desktop",
    "gui"
  ],
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
